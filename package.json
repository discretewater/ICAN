{
  "name": "@wizardelf/ican",
  "version": "0.1.0",
  "description": "ICAN - Local-first IAM policy evaluation engine for static analysis and CI/code-review assistance",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ican": "dist/cli/ican.js"
  },
  "files": [
